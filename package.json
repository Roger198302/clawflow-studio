{
  "name": "clawflow-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebUI-first visual Agent workflow orchestration workbench.",
  "scripts": {
    "dev:web": "pnpm --filter @clawflow/web dev",
    "dev:gateway": "pnpm --filter @clawflow/gateway dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.0"
}
